# Line endings, independent of each machine's git settings (core.autocrlf).
# The repository stores text with LF; checkouts convert where needed.

# Default: git decides what is text, stores it with LF.
* text=auto

# Windows batch files MUST have CRLF: cmd mis-handles labels/goto with LF only.
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell scripts MUST have LF (they run inside Linux containers / CI).
*.sh text eol=lf

# Never touch binary files.
*.png binary
*.zip binary

# Raw source fixtures: stored byte for byte (the FCR CSV has CRLF and a BOM
# that staging must handle, and the bytes must match the sha256 in _meta.json).
tests/fixtures/raw/** -text
