# Copy to ".env" (same folder as docker-compose.yml) and fill in.
# .env is git-ignored. .env.example (this file, no real values) IS committed.

AIRFLOW_UID=50000
AIRFLOW_IMAGE=apache/airflow:3.0.6

# UI login
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# Generate both with the one-liners in the step notes. Never commit real values.
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1