# Copy to ".env" (same folder as docker-compose.yml) and fill in.
# .env is git-ignored. .env.example (this file, no real values) IS committed.

AIRFLOW_UID=50000

# UI login
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# Generate both with the one-liners in the step notes. Never commit real values.
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# AWS: NO access keys. Airflow and the local scripts assume the IAM role
# battery-optimizer-airflow through this profile (add it to ~/.aws/config,
# see README "Running it"), after `aws sso login --profile battery-optimizer`.
AWS_PROFILE=battery-optimizer-airflow
AWS_DEFAULT_REGION=eu-north-1
# The lake bucket created by Terraform (terraform output lake_bucket_name).
LAKE_BUCKET=battery-optimizer-lake-<suffix>

WAREHOUSE_USER=battery
WAREHOUSE_PASSWORD=changeme
WAREHOUSE_DB=battery

# Password of the read-only api_reader role (sql/002_create_api_reader.sql).
API_READER_PASSWORD=
